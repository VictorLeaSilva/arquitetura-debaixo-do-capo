# Modelo do arquivo .env lido pelo docker compose (T-004).
# Copie para .env antes de subir a infraestrutura. O .env real nunca vai para o git (o .gitignore cobre).
# Os valores abaixo são só para desenvolvimento local: o banco fica preso em 127.0.0.1.
POSTGRES_DB=lab
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
