{
  "name": "arquitetura-debaixo-do-capo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start --host 127.0.0.1 --port 3001",
    "build": "docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "serialize-javascript": "7.1.4",
    "tinypool": "2.2.0"
  },
  "engines": {
    "node": ">=26"
  }
}
