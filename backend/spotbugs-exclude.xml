<?xml version="1.0" encoding="UTF-8"?>
<!--
  Exceções do SpotBugs (04 §5: toda supressão tem motivo, tarefa e validade).

  Q-036 · EI_EXPOSE_REP2 fora dos pacotes domain
  - Motivo: o aviso dispara quando uma classe guarda, no construtor, um objeto que o SpotBugs julga mutável, e ele
    julga pelo nome dos métodos (clear, load, init, add, set, insert, delete...). Nas classes do Spring, os objetos
    recebidos no construtor são colaboradores (singletons criados e guardados pelo próprio contêiner), não estado que
    alguém de fora possa alterar. Nos pacotes domain, guardar uma coleção recebida sem copiar é bug de verdade, então
    lá o aviso continua valendo.
  - Tarefa: T-010 (primeira classe a disparar: ReferenceDataSeeder).
  - Validade: 2027-05-14. A T-031 (fim do MVP) reavalia antes disso; se a regra continuar valendo, renova a data aqui.
    O SpotBugs não tem filtro com data: a data é conferida pela revisão de cada tarefa que mexer neste arquivo.
-->
<FindBugsFilter
        xmlns="https://github.com/spotbugs/filter/3.0.0"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <Match>
        <Bug pattern="EI_EXPOSE_REP2"/>
        <Not>
            <Package name="~io\.github\.victorleasilva\.capo\.(.+\.)?domain(\..*)?"/>
        </Not>
    </Match>
</FindBugsFilter>
